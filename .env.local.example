# Supabase プロジェクトの設定値をコピーして .env.local を作成してください。
# Supabaseダッシュボード > Project Settings > API から取得できます。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ユーザー削除時にauth.usersのアカウント(メールアドレス含む)も完全に削除するために使用する。
# Project Settings > API > service_role secret から取得。ブラウザに絶対に露出させないこと
# (サーバー専用のRoute Handler `src/app/api/admin/delete-user/route.ts` でのみ使用)。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push通知(お知らせ投稿時にプッシュ通知を送る)用のVAPID鍵ペア。
# `npx web-push generate-vapid-keys` で生成できる。PRIVATE_KEYはブラウザに
# 絶対に露出させないこと(サーバー専用のRoute Handlerでのみ使用)。
# 未設定でもアプリ自体は動作し、プッシュ通知の送信だけがスキップされる。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# 出欠登録リマインドの日次バッチ(vercel.jsonのcronから毎朝叩かれる
# `src/app/api/cron/attendance-reminders/route.ts`)を、外部から誰でも叩けないように保護する鍵。
# 適当なランダム文字列でよい。Vercelはcronリクエスト時に自動でAuthorization: Bearer <この値>を
# 付与してくれる。未設定でもバッチ自体は動くが、誰でもエンドポイントを叩けてしまうため
# 本番では設定を強く推奨する。
CRON_SECRET=your-random-secret

# Stripe決済(課金プランの申し込み・お支払い管理)。
# ダッシュボード > 開発者向け > APIキー から取得(まずはテストモードのキーでよい)。
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhookエンドポイント(src/app/api/webhooks/stripe/route.ts)の署名検証用シークレット。
# ダッシュボード > 開発者向け > Webhook でエンドポイントを登録すると発行される。
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# 中間プラン・フルプラン・フルプラス(Pro AI Plus)プランに対応するStripeのPrice ID
# (月額のサブスクリプション用)。ダッシュボード > 商品カタログ で商品(価格)を作成すると発行される。
STRIPE_PRICE_ID_MIDDLE=price_your-middle-plan-price-id
STRIPE_PRICE_ID_FULL=price_your-full-plan-price-id
STRIPE_PRICE_ID_PRO_PLUS=price_your-pro-plus-plan-price-id
# 同じ3プランの年払い用Price ID(月額の12ヶ月分から10%オフ)。同じ商品に価格を追加する形で作成する。
STRIPE_PRICE_ID_MIDDLE_YEARLY=price_your-middle-plan-yearly-price-id
STRIPE_PRICE_ID_FULL_YEARLY=price_your-full-plan-yearly-price-id
STRIPE_PRICE_ID_PRO_PLUS_YEARLY=price_your-pro-plus-plan-yearly-price-id

# AI分析機能(Pro AI Plusプラン限定、選手・チームの成績データをAIに分析させてコメントを
# 生成する)用のAPIキー。console.anthropic.comで発行。未設定でもアプリ自体は動作し、
# AI分析ボタンを押した時にエラーになるだけ。
ANTHROPIC_API_KEY=sk-ant-your-api-key
